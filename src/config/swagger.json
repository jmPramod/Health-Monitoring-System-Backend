{
  "openapi": "3.0.3",
  "info": {
    "title": "Health Care Management API Documentation",
    "description": "API documentation for Health Care Management System",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:4500",
      "description": "Local development server"
    },
    {
      "url": "https://health-monitoring-system-backend-eight.vercel.app",
      "description": "Production server"
    }
  ],
  "tags": [
    {
      "name": "Authentication",
      "description": "Endpoints for user authentication"
    },
    {
      "name": "Common Register Table",
      "description": "Endpoints for managing Op-list-table"
    },
    {
      "name": "Patient Registration",
      "description": "Registration Management APIs"
    }
  ],
  "paths": {
    "/register": {
      "post": {
        "tags": ["Authentication"],
        "summary": "User registration",
        "description": "Creates a new user account with the provided details.",
        "requestBody": {
          "description": "User registration details",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterUser"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "User created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "status": {
                      "type": "integer",
                      "example": 201
                    },
                    "message": {
                      "type": "string",
                      "example": "New User created"
                    },
                    "data": {
                      "$ref": "#/components/schemas/UserResponse"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Validation error"
          },
          "409": {
            "description": "User already exists"
          }
        }
      }
    },
    "/login": {
      "post": {
        "tags": ["Authentication"],
        "summary": "User login",
        "description": "Authenticates a user with the provided credentials.",
        "requestBody": {
          "description": "Login credentials",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginUser"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "User logged in successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "message": {
                      "type": "string",
                      "example": "Login successful"
                    },
                    "token": {
                      "type": "string",
                      "example": "JWT_TOKEN_STRING"
                    },
                    "data": {
                      "$ref": "#/components/schemas/UserResponse"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Invalid credentials"
          }
        }
      }
    },
    "/patient": {
      "post": {
        "tags": ["Patient Registration"],
        "summary": "Create Patient",
        "description": "Creates a new patient record.",
        "security": [{ "JWTAuth": [] }],
        "requestBody": {
          "description": "Complete patient creation details",
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreatePatient" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Patient created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreatePatientResponse"
                }
              }
            }
          },
          "400": { "description": "Validation Error" },
          "401": { "description": "Unauthorized" },
          "500": { "description": "Internal Server Error" }
        }
      }
    },
    "/patient/{patientId}": {
      "get": {
        "tags": ["Patient Registration"],
        "summary": "Get Patient by ID",
        "description": "Fetches a single patient record by MongoDB ObjectId.",
        "security": [{ "JWTAuth": [] }],
        "parameters": [
          {
            "name": "patientId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "description": "Patient MongoDB ObjectId",
            "example": "68b1d92f65d84c8fbf89abce"
          }
        ],
        "responses": {
          "200": {
            "description": "Patient fetched successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreatePatientResponse"
                }
              }
            }
          },
          "401": { "description": "Unauthorized" },
          "404": { "description": "Patient not found" },
          "500": { "description": "Internal Server Error" }
        }
      },
      "patch": {
        "tags": ["Patient Registration"],
        "summary": "Update Patient",
        "description": "Updates an existing patient record by MongoDB ObjectId.",
        "security": [{ "JWTAuth": [] }],
        "parameters": [
          {
            "name": "patientId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "example": "68b1d92f65d84c8fbf89abce"
          }
        ],
        "requestBody": {
          "description": "Fields to update",
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreatePatient" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Patient updated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreatePatientResponse"
                }
              }
            }
          },
          "400": { "description": "Validation Error" },
          "401": { "description": "Unauthorized" },
          "404": { "description": "Patient not found" },
          "500": { "description": "Internal Server Error" }
        }
      },
      "delete": {
        "tags": ["Patient Registration"],
        "summary": "Delete Patient",
        "description": "Deletes a patient record by MongoDB ObjectId.",
        "security": [{ "JWTAuth": [] }],
        "parameters": [
          {
            "name": "patientId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "example": "68b1d92f65d84c8fbf89abce"
          }
        ],
        "responses": {
          "200": {
            "description": "Patient deleted successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "example": true },
                    "status": { "type": "integer", "example": 200 },
                    "message": {
                      "type": "string",
                      "example": "Patient deleted successfully"
                    }
                  }
                }
              }
            }
          },
          "401": { "description": "Unauthorized" },
          "404": { "description": "Patient not found" },
          "500": { "description": "Internal Server Error" }
        }
      }
    },
    "/patient-list": {
      "get": {
        "tags": ["Patient Registration"],
        "summary": "Get Patient List",
        "description": "Returns a paginated and filterable list of patients.",
        "security": [
          {
            "JWTAuth": []
          }
        ],
        "parameters": [
          {
            "name": "search",
            "in": "query",
            "description": "Search across patient ID, first name, last name, mobile number, or OP case number (case-insensitive partial match)",
            "required": false,
            "schema": {
              "type": "string"
            },
            "example": "John"
          },
          {
            "name": "registration_date_from",
            "in": "query",
            "description": "Filter records registered on or after this date",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date"
            },
            "example": "2026-01-01"
          },
          {
            "name": "registration_date_to",
            "in": "query",
            "description": "Filter records registered on or before this date",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date"
            },
            "example": "2026-12-31"
          }
        ],
        "responses": {
          "200": {
            "description": "Patients fetched successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PatientListResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },

    "/link-patient": {
      "patch": {
        "tags": ["Patient Registration"],
        "summary": "Link Two Patients",
        "description": "Links one patient to another patient by adding the linked patient's ID and relationship to the owner patient's link_others array.",
        "security": [
          {
            "JWTAuth": []
          }
        ],
        "requestBody": {
          "description": "Owner patient, patient to link, and their relationship",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LinkPatientRequest"
              },
              "example": {
                "owener": "68b1d92f65d84c8fbf89abce",
                "linkedPerson": "68b1d92f65d84c8fbf89abcf",
                "type": "Father"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Patient linked successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LinkPatientResponse"
                },
                "example": {
                  "success": true,
                  "message": "Patient linked successfully",
                  "data": {
                    "_id": "68b1d92f65d84c8fbf89abce",
                    "first_name": "John",
                    "last_name": "Doe",
                    "link_others": [
                      {
                        "id": "68b1d92f65d84c8fbf89abcf",
                        "relation": "Father"
                      }
                    ]
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid request or a patient cannot be linked to themselves"
          },
          "401": {
            "description": "Unauthorized - authentication required"
          },
          "404": {
            "description": "Owner patient or patient to link does not exist"
          },
          "409": {
            "description": "Patients are already linked"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },

    "/op-list": {
      "get": {
        "tags": ["Common Register Table"],
        "summary": "Get OP Case List",
        "description": "Returns a paginated list of OP cases with optional search, registration date filters, and visit type filtering.",
        "security": [{ "JWTAuth": [] }],
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "minimum": 1, "default": 1 },
            "example": 1,
            "description": "Page number"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "minimum": 1, "default": 10 },
            "example": 10,
            "description": "Number of records per page"
          },
          {
            "name": "search",
            "in": "query",
            "required": false,
            "schema": { "type": "string" },
            "example": "John",
            "description": "Search by patient ID, first name, last name, mobile number, or OP case number"
          },
          {
            "name": "registration_date_from",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "format": "date" },
            "example": "2026-01-01",
            "description": "Filter registration dates from this date"
          },
          {
            "name": "registration_date_to",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "format": "date" },
            "example": "2026-12-31",
            "description": "Filter registration dates through this date, inclusive"
          },
          {
            "name": "visit_type",
            "in": "query",
            "required": false,
            "schema": { "type": "string" },
            "example": "re-visit",
            "description": "Filter by visit type"
          }
        ],
        "responses": {
          "200": {
            "description": "OP case list fetched successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpCaseListResponse"
                },
                "example": {
                  "success": true,
                  "status": 200,
                  "message": "op_list fetched successfully",
                  "data": [
                    {
                      "_id": "68b1d92f65d84c8fbf89abce",
                      "op_case_no": "OP261020-0001",
                      "patient_id": "PAT-000001",
                      "visit_type": "re-visit",
                      "revisit_status": true,
                      "revisit_date": "2026-10-20T10:00:00.000Z",
                      "revisit_info": {
                        "department": "Cardiology",
                        "consulting_dr": "Dr. Kumar",

                        "reason": "Follow-up consultation"
                      },
                      "first_name": "John",
                      "last_name": "Doe",
                      "mobile_no": "9876543210",
                      "hospital_id": "68b1d92f65d84c8fbf89abcd",
                      "registration_date": "2026-10-10T10:00:00.000Z"
                    }
                  ],
                  "pagination": {
                    "totalRecords": 1,
                    "currentPage": 1,
                    "totalPages": 1,
                    "limit": 10,
                    "hasNextPage": false,
                    "hasPreviousPage": false
                  }
                }
              }
            }
          },
          "401": { "description": "Unauthorized" },
          "500": { "description": "Internal Server Error" }
        }
      }
    },
    "/re-visit": {
      "post": {
        "tags": ["Common Register Table"],
        "summary": "Create Patient Revisit",
        "description": "Creates a new OP case revisit record. The OP case number, revisit date, revisit status, and created_by are generated or assigned by the server.",
        "security": [{ "JWTAuth": [] }],
        "requestBody": {
          "required": true,
          "description": "Patient and revisit information",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateRevisitRequest"
              },
              "example": {
                "patient_id": "PAT-000001",
                "visit_type": "re-visit",
                "visit_date": "2026-10-20T10:00:00.000Z",
                "department": "Cardiology",
                "consulting_dr": "Dr. Kumar",

                "reason": "Follow-up consultation",
                "registration_date": "2026-10-10T10:00:00.000Z",
                "first_name": "John",
                "last_name": "Doe",
                "mobile_no": "9876543210",
                "hospital_id": "68b1d92f65d84c8fbf89abcd"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Revisit created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateRevisitResponse"
                },
                "example": {
                  "success": true,
                  "status": 201,
                  "message": "New patient created successfully",
                  "data": {
                    "op_case_lookup": {
                      "_id": "68b1d92f65d84c8fbf89abce",
                      "op_case_no": "OP261020-0001",
                      "patient_id": "PAT-000001",
                      "visit_type": "re-visit",
                      "revisit_status": true,
                      "revisit_date": "2026-10-20T10:00:00.000Z",
                      "revisit_info": {
                        "department": "Cardiology",
                        "consulting_dr": "Dr. Kumar",

                        "reason": "Follow-up consultation"
                      },
                      "created_by": "68b1d92f65d84c8fbf89abcf",
                      "first_name": "John",
                      "last_name": "Doe",
                      "mobile_no": "9876543210",
                      "hospital_id": "68b1d92f65d84c8fbf89abcd",
                      "registration_date": "2026-10-10T10:00:00.000Z"
                    }
                  }
                }
              }
            }
          },
          "400": { "description": "Validation error" },
          "401": { "description": "Unauthorized" },
          "500": { "description": "Internal Server Error" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "JWTAuth": {
        "type": "apiKey",
        "name": "Authorization",
        "in": "header",
        "description": "JWT Authorization header using the Bearer scheme. Example: Authorization: Bearer <token>"
      }
    },
    "schemas": {
      "RegisterUser": {
        "type": "object",
        "required": [
          "first_name",
          "phone",
          "country",
          "pinCode",
          "email",
          "password"
        ],
        "properties": {
          "first_name": {
            "type": "string",
            "example": "John"
          },
          "last_name": {
            "type": "string",
            "example": "Doe"
          },
          "phone": {
            "type": "number",
            "example": 9876543210
          },
          "address": {
            "type": "string",
            "example": "123 Main Street"
          },
          "state": {
            "type": "string",
            "example": "Karnataka"
          },
          "country": {
            "type": "string",
            "example": "India"
          },
          "pinCode": {
            "type": "number",
            "example": 560001
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "john@example.com"
          },
          "password": {
            "type": "string",
            "format": "password",
            "example": "SecurePassword123"
          },
          "isAdmin": {
            "type": "string",
            "enum": ["admin", "user"],
            "default": "user",
            "example": "user"
          }
        }
      },

      "RevisitInfo": {
        "type": "object",
        "nullable": true,
        "properties": {
          "department": {
            "type": "string",
            "nullable": true,
            "example": "Cardiology"
          },
          "consulting_dr": {
            "type": "string",
            "nullable": true,
            "example": "Dr. Kumar"
          },

          "reason": {
            "type": "string",
            "nullable": true,
            "example": "Follow-up consultation"
          }
        }
      },
      "CreateRevisitRequest": {
        "type": "object",
        "required": [
          "patient_id",
          "hospital_id",
          "first_name",
          "registration_date",
          "mobile_no"
        ],
        "properties": {
          "patient_id": {
            "type": "string",
            "example": "PAT-000001"
          },
          "hospital_id": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{24}$",
            "example": "68b1d92f65d84c8fbf89abcd"
          },
          "visit_type": {
            "type": "string",
            "example": "re-visit"
          },
          "visit_date": {
            "type": "string",
            "format": "date-time",
            "example": "2026-10-20T10:00:00.000Z"
          },
          "department": {
            "type": "string",
            "nullable": true,
            "example": "Cardiology"
          },
          "consulting_dr": {
            "type": "string",
            "nullable": true,
            "example": "Dr. Kumar"
          },

          "reason": {
            "type": "string",
            "nullable": true,
            "example": "Follow-up consultation"
          },
          "registration_date": {
            "type": "string",
            "format": "date-time",
            "example": "2026-10-10T10:00:00.000Z"
          },
          "first_name": {
            "type": "string",
            "example": "John"
          },
          "last_name": {
            "type": "string",
            "example": "Doe"
          },
          "mobile_no": {
            "type": "string",
            "example": "9876543210"
          }
        }
      },
      "OpCaseListItem": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string",
            "example": "68b1d92f65d84c8fbf89abce"
          },
          "op_case_no": {
            "type": "string",
            "example": "OP261020-0001"
          },
          "patient_id": {
            "type": "string",
            "example": "PAT-000001"
          },
          "visit_type": {
            "type": "string",
            "example": "re-visit"
          },
          "created_by": {
            "type": "string",
            "example": "68b1d92f65d84c8fbf89abcf"
          },
          "visit_date": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "revisit_status": {
            "type": "boolean",
            "nullable": true,
            "example": true
          },
          "revisit_date": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "revisit_info": {
            "$ref": "#/components/schemas/RevisitInfo"
          },
          "registration_date": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "first_name": {
            "type": "string",
            "nullable": true,
            "example": "John"
          },
          "last_name": {
            "type": "string",
            "nullable": true,
            "example": "Doe"
          },
          "mobile_no": {
            "type": "string",
            "nullable": true,
            "example": "9876543210"
          },
          "hospital_id": {
            "type": "string",
            "example": "68b1d92f65d84c8fbf89abcd"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "CreateRevisitResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": true
          },
          "status": {
            "type": "integer",
            "example": 201
          },
          "message": {
            "type": "string",
            "example": "New patient created successfully"
          },
          "data": {
            "type": "object",
            "properties": {
              "op_case_lookup": {
                "$ref": "#/components/schemas/OpCaseListItem"
              }
            }
          }
        }
      },
      "OpCaseListResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": true
          },
          "status": {
            "type": "integer",
            "example": 200
          },
          "message": {
            "type": "string",
            "example": "op_list fetched successfully"
          },
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OpCaseListItem"
            }
          },
          "pagination": {
            "$ref": "#/components/schemas/Pagination"
          }
        }
      },
      "LinkPatientRequest": {
        "type": "object",
        "required": ["owener", "linkedPerson", "type"],
        "properties": {
          "owener": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{24}$",
            "description": "MongoDB ObjectId of the owner patient",
            "example": "68b1d92f65d84c8fbf89abce"
          },
          "linkedPerson": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{24}$",
            "description": "MongoDB ObjectId of the patient to link",
            "example": "68b1d92f65d84c8fbf89abcf"
          },
          "type": {
            "type": "string",
            "description": "Relationship of the linked patient to the owner patient",
            "example": "Father"
          }
        }
      },
      "LinkPatientResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": true
          },
          "message": {
            "type": "string",
            "example": "Patient linked successfully"
          },
          "data": {
            "type": "object",
            "properties": {
              "_id": {
                "type": "string",
                "example": "68b1d92f65d84c8fbf89abce"
              },
              "first_name": {
                "type": "string",
                "example": "John"
              },
              "last_name": {
                "type": "string",
                "example": "Doe"
              },
