<style>
  .active-theme {
    color: var(--primary);
  }
</style>

<div
  class="w-full px-6 flex items-center justify-between bg-[var(--surface)] rounded-2xl p-4"
>

  <!-- Left Side -->
  <div
    id="modelOpen"
    class="flex items-center gap-3 text-[var(--sec-text)] cursor-pointer"
  >
    <i class="fa-solid fa-magnifying-glass text-lg"></i>
    <span>Search...</span>
  </div>

  <!-- Right Side -->
  <div class="flex items-center gap-6">

    <!-- Theme Toggle -->
    <div class="relative">

      <button
        id="themeToggle"
        class="text-2xl text-[var(--sec-text)] hover:text-[var(--primary)] transition-all duration-300 cursor-pointer"
      >
        <i class="fa-regular fa-moon"></i>
      </button>

      <!-- Dropdown -->
      <div
        id="togglemodel"
        class="hidden absolute top-full mt-3 left-1/2 -translate-x-1/2 w- rounded-xl bg-[var(--surface)] border border-[var(--border)] shadow-xl p-4 z-50"
      >

        <div class="flex flex-col justify-between gap-4">

          <!-- Dark -->
          <div class="flex items-center flex-1">
            <button
              class="theme-option flex item-center w-full justify-center gap-3 border border-[var(--border)] hover:border-[var(--primary)] hover:bg-[var(--primary)]/10 transition"
              data-theme="dark"
            >
              <i class="fa-regular fa-moon text-[var(--text)]"></i>
              <p class="text-sm text-[var(--text)]">
                Dark
              </p>
            </button>

          </div>

          <!-- Light -->
          <div class="flex items-center flex-1">
            <button
              class="theme-option flex item-center w-full justify-center gap-3 border border-[var(--border)] hover:border-[var(--primary)] hover:bg-[var(--primary)]/10 transition"
              data-theme="light"
            >
              <i class="fa-regular fa-sun text-[var(--text)]"></i>
              <p class="text-sm text-[var(--text)]">
                Light
              </p>
            </button>

          </div>

          <!-- System -->
          <div class="flex items-center flex-1">
            <button
              class="theme-option flex item-center w-full justify-center gap-3 border border-[var(--border)] hover:border-[var(--primary)] hover:bg-[var(--primary)]/10 transition"
              data-theme="system"
            >
              <i class="fa-solid fa-computer text-[var(--text)]"></i>
              <p class="text-sm text-[var(--text)]">
                System
              </p>
            </button>

          </div>

        </div>

      </div>

    </div>

    <!-- Profile -->
    <div class="relative cursor-pointer">
      <img
        src="https://demos.pixinvent.com/vuexy-html-admin-template/assets/img/avatars/1.png"
        class="w-12 h-12 rounded-full border-2 border-[var(--border)]"
      />

      <span
        class="absolute bottom-0 right-0 w-3.5 h-3.5 rounded-full bg-green-500 border-2 border-[var(--surface)]"
      ></span>
    </div>

  </div>

</div>

<script>
  const themeButton = document.getElementById("themeToggle"); const dropdown =
  document.getElementById("togglemodel"); themeButton.addEventListener("click",
  function (e) { e.stopPropagation(); dropdown.classList.toggle("hidden");
  themeButton.classList.toggle("active-theme"); });
  dropdown.addEventListener("click", function (e) { e.stopPropagation(); });
  document.addEventListener("click", function () {
  dropdown.classList.add("hidden");
  themeButton.classList.remove("active-theme"); }); const themeOptions =
  document.querySelectorAll(".theme-option"); themeOptions.forEach((button) => {
  button.addEventListener("click", function () { const theme =
  this.dataset.theme; console.log("Selected Theme:", theme); // Example: //
  document.documentElement.setAttribute("data-theme", theme);
  dropdown.classList.add("hidden");
  themeButton.classList.remove("active-theme"); }); });

</script>